# Runtime model configuration (never commit real values)
MODEL_API_KEY=
ZHIHU_OPENAI_NEXT_API_KEY=
MODEL_BASE_URL=https://api.openai-next.com/v1
MODEL_NAME=gpt-6-astra
MODEL_REASONING_EFFORT=max
MODEL_TIMEOUT_MS=180000
MODEL_MAX_OUTPUT_TOKENS=10000

# start defaults to the live contest source. Use `npm run demo` before the contest;
# demo content and responses are project-authored and never presented as Zhihu content.
ZHIHU_CONTENT_MODE=live
HOST=127.0.0.1
PORT=3000
MAX_REQUEST_BYTES=65536
BODY_TIMEOUT_MS=15000
MAX_GENERATION_CONCURRENT=2
